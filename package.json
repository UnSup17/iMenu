{
  "name": "imenu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:server": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs watch server.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node ./node_modules/prisma/build/index.js migrate dev",
    "db:generate": "node ./node_modules/prisma/build/index.js generate",
    "db:seed": "node ./node_modules/prisma/build/index.js db seed",
    "db:studio": "node ./node_modules/prisma/build/index.js studio",
    "db:reset": "node ./node_modules/prisma/build/index.js migrate reset --force"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^5.22.0",
    "@upstash/redis": "^1.38.2",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^2.4.3",
    "ioredis": "^6.0.0",
    "next": "16.3.2",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "otpauth": "^9.5.2",
    "pdfjs-dist": "^6.2.108",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
