datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// Enums
// ============================================================

enum Role {
  SUPERADMIN
  RESTAURANT_ADMIN
  WAITER
  KITCHEN
}

enum TableStatus {
  AVAILABLE
  ACTIVE_QR_SESSION
  TRADITIONAL_SERVICE
  MAINTENANCE
}

enum SessionStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum ModifierType {
  SINGLE_SELECT // Variantes exclusivas (ej. Tipo de Pan, Término)
  ADDON         // Extras opcionales con costo (ej. Extra queso, Salsas)
}

// ============================================================
// Modelos Core
// ============================================================

model Restaurant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  currency  String   @default("USD")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  tables     Table[]
  categories Category[]
  products   Product[]
  orders     Order[]

  @@map("restaurants")
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.LongText
  access_token      String? @db.LongText
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.LongText
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  // @@id requerido para MySQL en Digital Ocean (sql_require_primary_key)
  @@id([identifier, token])
  @@map("verification_tokens")
}

model User {
  id           String     @id @default(uuid())
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  email        String     @unique
  emailVerified DateTime?
  passwordHash String?
  name         String?
  image        String?
  role         Role       @default(WAITER)
  createdAt    DateTime   @default(now())

  accounts       Account[]
  sessions       Session[]
  assignedTables Table[] @relation("WaiterAssignedTables")

  @@map("users")
}

model Table {
  id           String      @id @default(uuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableNumber  Int
  zone         String? // Ej. Terraza, Salón Principal
  status       TableStatus @default(AVAILABLE)

  assignedWaiterId String?
  assignedWaiter   User?   @relation("WaiterAssignedTables", fields: [assignedWaiterId], references: [id])

  sessions TableSession[]
  orders   Order[]

  @@unique([restaurantId, tableNumber])
  @@map("tables")
}

model TableSession {
  id           String        @id @default(uuid())
  tableId      String
  table        Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  sessionToken String        @unique // Token efímero UUID firmado
  status       SessionStatus @default(ACTIVE)
  expiresAt    DateTime
  createdAt    DateTime      @default(now())
  closedAt     DateTime?

  orders Order[]

  @@index([sessionToken, status])
  @@map("table_sessions")
}

// ============================================================
// Catálogo
// ============================================================

model Category {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  orderIndex   Int        @default(0)
  isActive     Boolean    @default(true)

  products Product[]

  @@map("categories")
}

model Product {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  basePrice    Decimal    @db.Decimal(10, 2)
  isAvailable  Boolean    @default(true)
  imageUrl     String?

  modifierGroups ModifierGroup[]
  ingredients    ProductIngredient[]
  orderItems     OrderItem[]

  @@map("products")
}

// Grupos de modificadores (ej: "Selección de Pan", "Término de Carne", "Extras")
model ModifierGroup {
  id         String       @id @default(uuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String // Ej: "Tipo de Pan", "Extras"
  type       ModifierType
  isRequired Boolean      @default(false)
  minSelect  Int          @default(0)
  maxSelect  Int          @default(1)

  options ModifierOption[]

  @@map("modifier_groups")
}

// Opciones de cada grupo (ej: "Pan Artesanal" +$0, "Extra Tocino" +$1.50)
model ModifierOption {
  id          String        @id @default(uuid())
  groupId     String
  group       ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String
  extraPrice  Decimal       @default(0.00) @db.Decimal(10, 2)
  isAvailable Boolean       @default(true)

  orderItemModifiers OrderItemModifier[]

  @@map("modifier_options")
}

// Ingredientes base removibles por el cliente (ej: "Cebolla", "Pepinillos")
model ProductIngredient {
  id          String  @id @default(uuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  isRemovable Boolean @default(true)

  removedInItems OrderItemRemovedIngredient[]

  @@map("product_ingredients")
}

// ============================================================
// Pedidos
// ============================================================

model Order {
  id           String        @id @default(uuid())
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId      String
  table        Table         @relation(fields: [tableId], references: [id])
  sessionId    String?
  session      TableSession? @relation(fields: [sessionId], references: [id])
  status       OrderStatus   @default(RECEIVED)
  totalAmount  Decimal       @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
  itemNotes String?

  modifiers          OrderItemModifier[]
  removedIngredients OrderItemRemovedIngredient[]

  @@map("order_items")
}

model OrderItemModifier {
  id               String         @id @default(uuid())
  orderItemId      String
  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOptionId String
  modifierOption   ModifierOption @relation(fields: [modifierOptionId], references: [id])
  priceCharged     Decimal        @db.Decimal(10, 2)

  @@map("order_item_modifiers")
}

model OrderItemRemovedIngredient {
  id           String            @id @default(uuid())
  orderItemId  String
  orderItem    OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   ProductIngredient @relation(fields: [ingredientId], references: [id])

  @@unique([orderItemId, ingredientId])
  @@map("order_item_removed_ingredients")
}
